#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# nginx path
NGINX_CONFIG=/etc/nginx/sites-available/default

# user passed env vars
CWS="${CUSTOM_PORT:-8082}"
CUSER="${CUSTOM_USER:-abc}"
SFOLDER="${SUBFOLDER:-/}"
[[ "${SFOLDER}" != */ ]] && SFOLDER="${SFOLDER}/"

# create self signed cert
if [[ ! -f /config/ssl/cert.pem ]]; then
    mkdir -p /config/ssl
    openssl req -new -x509 \
        -days 3650 -nodes \
        -out /config/ssl/cert.pem \
        -keyout /config/ssl/cert.key \
        -subj "/C=US/ST=CA/L=Carlsbad/O=Linuxserver.io/OU=LSIO Server/CN=*"
    chmod 600 /config/ssl/cert.key
    lsiown -R abc:abc /config/ssl
fi

# selkies subfolder
if [[ -z ${SELKIES_SUBFOLDER+x} ]]; then
    printf "%s" "${SFOLDER}selkies/" > /run/s6/container_environment/SELKIES_SUBFOLDER
fi

# modify nginx config
cp /defaults/default.conf "${NGINX_CONFIG}"
sed -i "s/CWS/${CWS}/g" "${NGINX_CONFIG}"
sed -i "s|SUBFOLDER|${SFOLDER}|g" "${NGINX_CONFIG}"
if [[ -n "${DISABLE_IPV6}" ]]; then
    sed -i '/listen \[::\]/d' "${NGINX_CONFIG}"
fi

# layer auth
if [[ -n "${PASSWORD}" ]]; then
    printf '%s:%s\n' "${CUSER}" "$(openssl passwd -apr1 "${PASSWORD}")" > /etc/nginx/.htpasswd
    sed -i 's/#auth_basic/auth_basic/g' "${NGINX_CONFIG}"
else
    rm -f /etc/nginx/.htpasswd
fi

# landing page
cp /defaults/landing.html /usr/share/selkies/web/landing.html
